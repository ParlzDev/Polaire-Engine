# ---- 构建产物 ----
build/
out/
cmake-build-*/
*.obj
*.o
*.lib
*.a
*.exe
*.dll
*.pdb
*.ilk
*.exp

# *.obj 同时是 Wavefront 模型的后缀。不放开的话 assets/models/cube.obj 不会进仓库，
# 而 05_model 的默认加载路径、README 与 prompts/M2 的验收项都指着这个文件。
# 只放开资产目录，编译产物仍然忽略。
!assets/**/*.obj

# ---- 工具缓存 ----
.cache/
.clangd/
.vs/
.vscode/
.idea/
.workbuddy-ai/

# ---- 运行时产物 ----
*.log
logs/
*.bin
screenshots/

# compile_commands.json 由 CMake 生成到 build/ 下，仓库根目录若出现也忽略
/compile_commands.json
